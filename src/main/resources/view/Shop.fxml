<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.Region?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.ShopController"
      spacing="0"
      styleClass="shop-page">

    <VBox styleClass="shop-header-card" spacing="14">
        <HBox styleClass="shop-header-top" alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Pet Shop" styleClass="shop-hero-title"/>
                <Label text="Des produits de qualité pour vos compagnons"
                       styleClass="shop-hero-subtitle"/>
            </VBox>

            <HBox styleClass="search-wrap" alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="searchField"
                           promptText="Rechercher un produit..."
                           styleClass="search-field-shop"/>
                <Button fx:id="searchButton"
                        onAction="#handleSearchClick"
                        styleClass="btn-search-retail">
                    <graphic>
                        <SVGPath styleClass="icon-fill-navy"
                                 scaleX="0.92" scaleY="0.92"
                                 content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79L20 21.49 21.49 20 15.5 14zM9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                    </graphic>
                </Button>
            </HBox>

            <ComboBox fx:id="sortCombo"
                      promptText="Trier par prix"
                      styleClass="combo-sort-shop"/>

            <Button fx:id="favorisHeaderButton"
                    onAction="#goToFavoris"
                    styleClass="btn-retail-fav">
                <graphic>
                    <SVGPath styleClass="icon-fill-navy"
                             scaleX="0.88" scaleY="0.88"
                             content="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </graphic>
            </Button>

            <StackPane alignment="CENTER">
                <Button fx:id="cartHeaderButton"
                        onAction="#goToPanier"
                        styleClass="btn-retail-cart">
                    <graphic>
                        <SVGPath styleClass="icon-fill-white"
                                 scaleX="0.88" scaleY="0.88"
                                 content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2zM7.16 14h9.45c.75 0 1.4-.41 1.74-1.03l3.24-5.88A1 1 0 0 0 20.74 6H6.21L5.27 4H2v2h2l3.6 7.59-1.35 2.44C5.52 17.37 6.48 19 8 19h12v-2H8l1.16-3z"/>
                    </graphic>
                </Button>
                <Label fx:id="cartBadgeLabel" text="0" styleClass="cart-badge-retail"/>
            </StackPane>
        </HBox>

        <HBox spacing="20"
              alignment="CENTER_LEFT"
              styleClass="shop-top-bar">

            <HBox fx:id="categoryBar"
                  styleClass="shop-category-bar"
                  spacing="8"
                  alignment="CENTER_LEFT">
                <padding>
                    <Insets top="2"/>
                </padding>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <CheckBox fx:id="alerteNouveauProduit"
                      text="M'alerter par email si un nouveau produit est disponible"
                      onAction="#handleAlerteCheckbox"
                      styleClass="shop-alerte-checkbox"/>
        </HBox>

    </VBox>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                styleClass="main-content"
                hbarPolicy="NEVER">

        <VBox spacing="8" styleClass="shop-grid-wrap">
            <padding>
                <Insets bottom="28" left="28" right="28" top="20"/>
            </padding>

            <FlowPane fx:id="productsPane"
                      hgap="36"
                      vgap="36"/>
        </VBox>

    </ScrollPane>

</VBox>
